# Copy this file to .env and fill in your own values
# Everything starting with VITE_ ends up in the browser, so never put a
# secret key here

# Address of our own backend server
VITE_API_URL=http://localhost:3000

# Supabase project settings (Dashboard -> Project Settings -> API)
# The anon key is meant to be public, the database is protected by the
# rules in supabase/rls-policies.sql
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
